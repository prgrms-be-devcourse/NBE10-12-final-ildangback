# Cloudinary 통합 테스트(CloudinaryStorageServiceIntegrationTest)용 env 템플릿.
# 값은 관련 채널에 전송되어있음
#
# 사용법:
#   cp .env.example .env
#   .env 에 실제 값 채우기 (따옴표 없이, LF 줄바꿈)
#
#   set -a; source ./.env; set +a
#   ./gradlew test --tests '*CloudinaryStorageServiceIntegrationTest' --rerun-tasks
#
# 주의:
#   - 값을 큰따옴표로 감싸지 말 것 ("..." 는 따옴표째 값에 포함됨)
#   - 이 파일을 CRLF 로 저장하지 말 것 (값 끝에 \r 이 붙어 서명이 깨짐)ㄷ

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
