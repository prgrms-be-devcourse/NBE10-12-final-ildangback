# grafana.conf 의 auth_basic_user_file 이 읽는 실물 파일은 grafana.htpasswd (커밋 안 됨).
# 이 예시 파일을 지우고 옆에 실물을 만든다.
#
# 생성 방법 (택1):
#
# 1) apache2-utils / httpd-tools 있으면:
#      htpasswd -c grafana.htpasswd gommit-team
#      (대화식으로 비번 입력. -c 는 새로 만들 때만 — 있는 파일에 추가할 땐 -c 빼고 재실행)
#
# 2) 없으면 openssl로 (bcrypt 대신 apr1, nginx 호환):
#      echo "gommit-team:$(openssl passwd -apr1)" > grafana.htpasswd
#
# 파일 내용은 이런 한 줄짜리 포맷:
#   gommit-team:$apr1$xxxxxxxx$yyyyyyyyyyyyyyyyyyyyyy
#
# EC2 배치: infra/nginx/conf.d/grafana.htpasswd 에 두면 docker-compose 의 nginx conf.d
# 볼륨 마운트에 자동으로 딸려간다 — 별도 volume 라인 추가 불필요(*.conf 만 include 되니
# nginx가 이 파일을 설정으로 파싱하지도 않음). chmod 600 권장.
