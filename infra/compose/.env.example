# EC2 /opt/team1-app/.env — GitHub Actions 배포 스텝이 렌더링. chmod 600. 커밋 금지.
# 값의 출처는 GitHub Actions Secrets (Q10).

# ---- 이미지 ----
GHCR_REPO=prgrms-be-devcourse/nbe10-12-final-ildangback   # 소문자
IMAGE_TAG=latest                                  # 배포 시 커밋 SHA 로 교체됨

# ---- DB (mysql 컨테이너) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=gommit
DB_USERNAME=gommit
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ---- 앱 ----
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET_KEY=change-me-min-32-bytes
CORS_ALLOWED_ORIGINS=https://go-mmit.site

# ---- 미디어 (Cloudinary) ----
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
